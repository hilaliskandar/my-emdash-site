{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "my-emdash-site",
	"workers_dev": false,
	"preview_urls": false,
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "my-emdash-site","database_id": "6acdfa80-2401-4416-94d4-d232ad3d45ad",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "my-emdash-media","preview_bucket_name": "my-emdash-media",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// Cron temporarily disabled: account uses 5 of 5 Workers Free cron slots.
}
